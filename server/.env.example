# ==========================================
# QuickBid Server - Environment Config
# ==========================================

# Port to run Express server
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/quickbid

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_long_example_random_string

# Cloudinary Cloud Storage Configuration (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
